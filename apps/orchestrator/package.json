{
  "name": "@llm-crane/orchestrator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "eval:routing": "vitest run --config ../../vitest.config.ts test/routingEval.test.ts",
    "eval:stages": "vitest run --config ../../vitest.config.ts test/stageEval.test.ts",
    "eval:gate": "vitest run --config ../../vitest.config.ts test/releaseGateEval.test.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.js",
    "test": "vitest run --config ../../vitest.config.ts test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@llm-crane/core": "workspace:*",
    "@llm-crane/providers": "workspace:*",
    "@llm-crane/prompts": "workspace:*",
    "@llm-crane/schemas": "workspace:*"
  }
}